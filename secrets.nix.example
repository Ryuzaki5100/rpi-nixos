# secrets.nix.example — template for secret credentials.
#
# Copy to `secrets.nix` (gitignored, NOT committed) and fill in real values,
# or run `./setup.sh` which generates it for you from prompts.
#
# These fields are referenced by configuration.nix / modules/minimal.nix via
# `import ./secrets.nix`. Keep this file out of git — it holds plaintext.
{
  # One-time bootstrap password for the desktop user. Run `passwd` on first
  # login to replace it; it is only an `initialPassword` seed.
  userPassword = "changeme";

  # WPA-PSK for the wifi network declared in local.nix.
  wifiPsk = "wifi-password";
}